# Sorties de compilation et caches d'outils
build/
.dart_tool/
.flutter-plugins*
coverage/

# Coffres: ne doivent jamais être versionnés, même par accident
*.safe
*.safe.bak

# Signature Android: le keystore et son mot de passe restent hors du dépôt
key.properties
*.jks
*.keystore

# Fichiers d'éditeur
.idea/
.vscode/
*.iml

# Divers
migrate_working_dir/
*.log
.DS_Store

# Maquettes de refonte: le README du handoff cite du texte présenté comme réel
# (adresses, mots de passe, note sur une clef SSH). Le dépôt est public, et le
# hook de sauvegarde fait « git add -A »: sans cette ligne, ces exemples
# partiraient sur GitHub tout seuls.
Safe App Design Refonte/
